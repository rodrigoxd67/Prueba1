  "city": "Trujillo",
  "countryOrRegion": "Peru",
  "maintenanceAuthCode": "Abc12345"
}

### Required fields: 400, Spanish messages
POST {{baseUrl}}/api/v1/workshops
Content-Type: application/json
Accept-Language: es

